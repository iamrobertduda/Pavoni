{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "Gemeinsame Typen",
  "$defs": {
    "i18n": {
      "type": "object",
      "required": ["de"],
      "properties": {"de": {"type": "string"}, "en": {"type": "string"}, "it": {"type": "string"}},
      "additionalProperties": false
    },
    "partId": {"type": "string", "pattern": "^[px][0-9]{3}_[a-z0-9]+(_[a-z0-9]+)*$"},
    "instanceId": {"type": "string", "pattern": "^[px][0-9]{3}_[a-z0-9]+(_[a-z0-9]+)*__[0-9]+$"},
    "assemblyId": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*$"},
    "ref": {
      "description": "Teil-ID, Instanz-ID oder Baugruppen-ID (Baugruppe = als Einheit abgenommen)",
      "type": "string",
      "pattern": "^([px][0-9]{3}_[a-z0-9]+(_[a-z0-9]+)*(__[0-9]+)?|[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*)$"
    },
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "explode": {
      "type": "object",
      "required": ["axis", "distance_mm", "stage"],
      "properties": {
        "axis": {"$ref": "#/$defs/vec3", "description": "Richtung im Rahmen der Baugruppe (CAD: Z oben, -Y vorn, +X rechts)"},
        "distance_mm": {"type": "number", "minimum": 0},
        "stage": {"type": "integer", "minimum": 1, "maximum": 9}
      },
      "additionalProperties": false
    },
    "confidence": {"enum": ["measured", "catalog", "spec", "photo", "guess"]},
    "status": {
      "description": "planned = nur in der Stückliste; blockout = grobe Form; modeled = detailliert modelliert; verified = im Rendering gegen Fotos/Quellen geprüft",
      "enum": ["planned", "blockout", "modeled", "verified"]
    }
  }
}
