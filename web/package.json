{
  "name": "pavoni-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "node scripts/build-data.mjs && vite",
    "build": "node scripts/build-data.mjs && tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint src scripts",
    "test": "vitest run",
    "preview": "vite preview",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.63.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "js-yaml": "^5.5.0",
    "meshoptimizer": "^1.3.0",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
